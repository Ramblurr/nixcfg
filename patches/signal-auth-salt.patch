+
+// Temporary compatibility for authCredentialSalt missing from SQL ITEM_SPECS.
+// JSON persistence turns its Uint8Array into an object with numeric keys.
+// Remove this when upstream repairs serialization and migrates existing values.
+function restoreAuthCredentialSalt(value: unknown): Uint8Array<ArrayBuffer> {
+  // Diagnostic only: never log the value, its bytes, or arbitrary property names.
+  const record = value != null && typeof value === 'object'
+    ? (value as Record<string, unknown>) : undefined;
+  const keys = record ? Object.keys(record) : [];
+  log.warn('[DEBUG-signal-salt-shape] ' + JSON.stringify({
+    valueType: typeof value,
+    isNull: value == null,
+    isUint8Array: value instanceof Uint8Array,
+    isArray: Array.isArray(value),
+    keyCount: keys.length,
+    allKeysNumeric: keys.length > 0 && keys.every(key => /^(0|[1-9][0-9]*)$/.test(key)),
+    isBufferJson: record?.type === 'Buffer',
+    dataIsArray: Array.isArray(record?.data),
+    dataLength: Array.isArray(record?.data) ? record.data.length : null,
+    typedLength: value instanceof Uint8Array ? value.length : null,
+  }));
+  if (value instanceof Uint8Array && value.buffer instanceof ArrayBuffer) {
+    strictAssert(value.length === 16, 'Invalid auth credential salt length');
+    return value;
+  }
+
+  strictAssert(
+    value != null && typeof value === 'object' && !Array.isArray(value),
+    'Invalid stored auth credential salt'
+  );
+  const entries = Object.entries(value);
+  strictAssert(
+    entries.length === 16 &&
+      entries.every(
+        ([key, byte], index) =>
+          key === String(index) &&
+          typeof byte === 'number' &&
+          Number.isInteger(byte) &&
+          byte >= 0 &&
+          byte <= 255
+      ),
+    'Invalid stored auth credential salt bytes'
+  );
+  return Uint8Array.from(entries.map(([, byte]) => byte));
+}
