#!/usr/bin/env bb
(ns databasus
  (:require [babashka.cli :as cli]
            [babashka.http-client :as http]
            [babashka.process :as p]
            [camel-snake-kebab.core :as csk]
            [cheshire.core :as json]
            [clojure.string :as str]
            [martian.core :as martian]
            [martian.interceptors :as martian-interceptors])
  (:import [java.net URLEncoder]))

(def body ::body)

(def default-guest-api-url "http://127.0.0.1:4005/api/v1")
(def swagger-path "/docs/swagger/doc.json")

(def global-option-keys
  #{:help
    :json
    :json-file
    :output
    :swagger-file
    :token
    :yes
    :transport
    :api-url
    :guest-api-url
    :ssh-host
    :vsock-cid
    :ssh-multiplex
    :multiplex
    :ssh-control-persist
    :control-persist
    :local-control-path
    :remote-control-path})

(def boolean-options #{:help :json :yes})

(defn blank->nil [s]
  (let [s* (some-> s str str/trim)]
    (when-not (str/blank? s*) s*)))

(defn env [k]
  (blank->nil (System/getenv k)))

(defn source-path-string [url-pattern]
  (cond-> (str url-pattern)
    (not (string? url-pattern)) (str/replace-first #"^:" "")))

(defn route-segment [segment]
  (-> segment
      (str/replace #"^[{:]+" "")
      (str/replace #"[}:]+$" "")
      csk/->kebab-case-string))

(defn full-path-route-name [url-pattern method _definition]
  (->> (str/split (source-path-string url-pattern) #"/+")
       (remove str/blank?)
       (map route-segment)
       (cons (name method))
       (str/join "-")
       keyword))

(def martian-interceptors
  (conj martian/default-interceptors martian-interceptors/default-encode-request))

(defn trim-trailing-slashes [s]
  (str/replace (str s) #"/+$" ""))

(defn api-root [config]
  (trim-trailing-slashes
   (if (= "direct" (:transport config))
     (or (blank->nil (:api-url config))
         (throw (ex-info "--api-url is required for direct transport"
                         {:transport "direct"})))
     (or (blank->nil (:guest-api-url config))
         default-guest-api-url))))

(defn swagger-url [api-root]
  (str (trim-trailing-slashes api-root) swagger-path))

(defn bootstrap-martian [api-root swagger]
  (martian/bootstrap-openapi api-root swagger
                             {:route-name-sources [full-path-route-name :operationId]
                              :interceptors martian-interceptors}))

(defn operation-catalog [martian-instance]
  (mapv (fn [{:keys [route-name method path summary]}]
          {:route-name route-name
           :method method
           :path path
           :summary summary})
        (:handlers martian-instance)))

(defn route-key [route-name]
  (if (keyword? route-name)
    route-name
    (keyword (str/replace (str route-name) #"^:" ""))))

(defn handler-for [martian-instance route-name]
  (let [route-name* (route-key route-name)]
    (some (fn [handler]
            (when (= route-name* (:route-name handler))
              handler))
          (:handlers martian-instance))))

(defn add-auth-header [params token]
  (if-let [token* (blank->nil token)]
    (update params ::martian/request
            (fn [request]
              (update (or request {}) :headers merge {"Authorization" token*})))
    params))

(defn normalize-operation-params [params]
  (cond-> (dissoc params ::body)
    (contains? params ::body) (assoc ::martian/body (::body params))))

(defn request-for-operation
  ([martian-instance route-name params]
   (request-for-operation martian-instance route-name params {}))
  ([martian-instance route-name params {:keys [token]}]
   (martian/request-for martian-instance
                        (route-key route-name)
                        (-> params
                            normalize-operation-params
                            (add-auth-header token)))))

(defn urlencode [s]
  (-> (URLEncoder/encode (str s) "UTF-8")
      (str/replace "+" "%20")))

(defn query-pairs [query-params]
  (mapcat (fn [[k v]]
            (if (sequential? v)
              (map #(vector k %) v)
              [[k v]]))
          query-params))

(defn query-string [query-params]
  (when (seq query-params)
    (->> (query-pairs query-params)
         (map (fn [[k v]] (str (urlencode (name k)) "=" (urlencode v))))
         (str/join "&"))))

(defn url-with-query [{:keys [url query-params]}]
  (if-let [query (query-string query-params)]
    (str url (if (str/includes? url "?") "&" "?") query)
    url))

(defn shell-quote [s]
  (str "'" (str/replace (str s) "'" "'\"'\"'") "'"))

(defn control-dir [control-path]
  (when-let [path (blank->nil control-path)]
    (let [idx (str/last-index-of path "/")]
      (when (and idx (pos? idx))
        (subs path 0 idx)))))

(defn ssh-mux-options [{:keys [multiplex control-persist control-path]}]
  (if (= "off" (str/lower-case (str multiplex)))
    []
    ["-o" "ControlMaster=auto"
     "-o" (str "ControlPersist=" (or (blank->nil control-persist) "300"))
     "-o" (str "ControlPath=" control-path)]))

(defn ssh-config-control-path [ssh-host]
  (try
    (let [result (p/shell {:out :string
                           :err :string
                           :continue true}
                          "ssh" "-G" ssh-host)]
      (when (zero? (:exit result))
        (some (fn [line]
                (when-let [[_ path] (re-find #"(?i)^controlpath\s+(.+)$" line)]
                  (let [path* (blank->nil path)]
                    (when (and path*
                               (not= "none" (str/lower-case path*)))
                      path*))))
              (str/split-lines (:out result)))))
    (catch Exception _
      nil)))

(defn curl-args [request]
  (let [method (-> (:method request) name str/upper-case)
        body? (contains? request :body)]
    (cond-> ["curl"
             "--silent"
             "--show-error"
             "--dump-header" "-"
             "--output" "-"
             "--request" method]
      (seq (:headers request))
      (into (mapcat (fn [[k v]] ["--header" (str k ": " v)]) (:headers request)))

      body?
      (into ["--data-binary" "@-"])

      true
      (conj (url-with-query request)))))

(defn remote-vsock-command [{:keys [vsock-cid remote-control-path multiplex control-persist]} request]
  (let [remote-control-dir (or (control-dir remote-control-path) "/run/databasus-cli-ssh")
        nested-ssh-args (concat ["ssh" "-o" "BatchMode=yes"]
                                (ssh-mux-options {:multiplex multiplex
                                                  :control-persist control-persist
                                                  :control-path remote-control-path})
                                ["-l" "root" (str "vsock/" vsock-cid)])
        curl-command (str/join " " (map shell-quote (curl-args request)))
        argv (concat nested-ssh-args [curl-command])]
    (str "install -d -m 700 " (shell-quote remote-control-dir)
         " && exec "
         (str/join " " (map shell-quote argv)))))

(defn ssh-vsock-request-plan [config request]
  (let [{:keys [ssh-host local-control-path multiplex control-persist]
         :or {ssh-host "sno-new"
              multiplex "auto"
              control-persist "300"}} config
        config* (merge {:vsock-cid "14"
                        :remote-control-path "/run/databasus-cli-ssh/vsock-%C"}
                       config)
        local-control-path* (or (blank->nil local-control-path)
                                (ssh-config-control-path ssh-host)
                                (str (or (env "XDG_RUNTIME_DIR") "/tmp") "/databasus-cli/sno-%C"))
        local-control-dir (when-not (= "off" (str/lower-case (str multiplex)))
                            (control-dir local-control-path*))
        ssh-args (concat ["ssh" "-o" "BatchMode=yes"]
                         (ssh-mux-options {:multiplex multiplex
                                           :control-persist control-persist
                                           :control-path local-control-path*})
                         [ssh-host
                          (remote-vsock-command config* request)])]
    {:cmd (vec ssh-args)
     :in (:body request)
     :response-as (:response-as request)
     :local-control-dir local-control-dir}))

(defn parse-status-line [line]
  (if-let [[_ status] (re-find #"^HTTP/\S+\s+(\d+)" (str line))]
    (parse-long status)
    (throw (ex-info (str "Unable to parse HTTP status from curl output: " line)
                    {:status-line line}))))

(defn parse-header-line [line]
  (when-let [idx (str/index-of line ":")]
    [(str/lower-case (str/trim (subs line 0 idx)))
     (str/trim (subs line (inc idx)))]))

(defn index-of-bytes [bytes pattern]
  (let [limit (- (alength bytes) (alength pattern))]
    (loop [i 0]
      (cond
        (> i limit) nil
        (loop [j 0]
          (cond
            (= j (alength pattern)) true
            (= (aget bytes (+ i j)) (aget pattern j)) (recur (inc j))
            :else false)) i
        :else (recur (inc i))))))

(defn parse-curl-response-string [stdout]
  (let [normalized (str/replace (or stdout "") "\r\n" "\n")
        split-idx (str/index-of normalized "\n\n")
        header-text (if split-idx (subs normalized 0 split-idx) normalized)
        response-body (if split-idx (subs normalized (+ split-idx 2)) "")
        header-lines (remove str/blank? (str/split-lines header-text))]
    (when-not (seq header-lines)
      (throw (ex-info "curl produced no HTTP response headers" {:stdout stdout})))
    {:status (parse-status-line (first header-lines))
     :headers (into {} (keep parse-header-line (rest header-lines)))
     :body response-body}))

(defn parse-curl-response-bytes [stdout]
  (let [crlf (.getBytes "\r\n\r\n" "UTF-8")
        lf (.getBytes "\n\n" "UTF-8")
        split-idx (or (index-of-bytes stdout crlf)
                      (index-of-bytes stdout lf))
        delimiter-len (if (= split-idx (index-of-bytes stdout crlf))
                        (alength crlf)
                        (alength lf))]
    (when-not split-idx
      (throw (ex-info "curl produced no HTTP response header delimiter" {})))
    (let [header-bytes (java.util.Arrays/copyOfRange stdout 0 split-idx)
          body-bytes (java.util.Arrays/copyOfRange stdout (+ split-idx delimiter-len) (alength stdout))
          parsed (parse-curl-response-string (String. header-bytes "UTF-8"))]
      (assoc parsed
             :body (String. body-bytes "UTF-8")
             :body-bytes body-bytes))))

(defn parse-curl-response [stdout]
  (if (bytes? stdout)
    (parse-curl-response-bytes stdout)
    (parse-curl-response-string stdout)))

(defn run-process-request! [{:keys [cmd in response-as]}]
  (let [bytes? (= :bytes response-as)
        result (apply p/shell
                      {:out (if bytes? :bytes :string)
                       :err :string
                       :in (or in "")
                       :continue true}
                      cmd)]
    (if (zero? (:exit result))
      (parse-curl-response (:out result))
      (throw (ex-info (str "Transport command failed with exit " (:exit result)
                           (when-let [err (blank->nil (:err result))]
                             (str ": " err)))
                      {:exit (:exit result)
                       :err (:err result)})))))

(defn ensure-private-dir! [path]
  (when-let [path* (blank->nil path)]
    (let [dir (java.io.File. path*)]
      (.mkdirs dir)
      (.setReadable dir false false)
      (.setWritable dir false false)
      (.setExecutable dir false false)
      (.setReadable dir true true)
      (.setWritable dir true true)
      (.setExecutable dir true true)
      dir)))

(defn ssh-vsock-curl-request! [config request]
  (let [plan (ssh-vsock-request-plan config request)]
    (ensure-private-dir! (:local-control-dir plan))
    (run-process-request! plan)))

(defn normalize-header-map [headers]
  (into {}
        (map (fn [[k v]]
               [(str/lower-case (if (keyword? k) (name k) (str k)))
                (if (sequential? v)
                  (str/join "," (map str v))
                  (str v))])
             headers)))

(defn direct-request! [_config request]
  (let [bytes? (= :bytes (:response-as request))
        response (http/request {:method (:method request)
                                :uri (url-with-query request)
                                :headers (:headers request)
                                :body (:body request)
                                :as (when bytes? :bytes)
                                :throw false})
        body (or (:body response) (if bytes? (byte-array 0) ""))]
    (cond-> {:status (:status response)
             :headers (normalize-header-map (:headers response))
             :body (if bytes? (String. body "UTF-8") body)}
      bytes? (assoc :body-bytes body))))

(defn make-transport [config]
  (case (or (blank->nil (:transport config)) "direct")
    "ssh-vsock-curl" #(ssh-vsock-curl-request! config %)
    "direct" #(direct-request! config %)
    (throw (ex-info (str "Unsupported Databasus transport: " (:transport config))
                    {:transport (:transport config)}))))

(defn json-content? [headers body]
  (let [content-type (or (get headers "content-type") "")]
    (or (str/includes? (str/lower-case content-type) "json")
        (boolean (re-find #"^\s*[\[{]" (or body ""))))))

(defn parse-json-body [s context]
  (try
    (json/parse-string s)
    (catch Exception e
      (throw (ex-info (str "Invalid JSON in " context ": " (ex-message e))
                      {:context context}
                      e)))))

(defn success-status? [status]
  (<= 200 (or status 0) 299))

(defn response-error-detail [{:keys [headers body]}]
  (let [body* (or body "")]
    (or (when (and (not (str/blank? body*))
                   (json-content? headers body*))
          (try
            (let [parsed (json/parse-string body*)]
              (or (get parsed "message")
                  (get parsed "error")))
            (catch Exception _ nil)))
        (blank->nil body*))))

(defn parse-api-response [{:keys [status headers body] :as response}]
  (let [headers* (normalize-header-map headers)
        body* (or body "")]
    (if (success-status? status)
      (cond
        (str/blank? body*) nil
        (json-content? headers* body*) (parse-json-body body* "response body")
        :else body*)
      (let [detail (response-error-detail (assoc response :headers headers*))]
        (throw (ex-info (str "Databasus API error " status
                             (when detail (str ": " detail)))
                        {:status status
                         :body body*}))))))

(defn read-json-file [path]
  (parse-json-body (slurp path) (str "JSON file " path)))

(defn load-swagger!
  ([config]
   (load-swagger! config (make-transport config)))
  ([config transport]
   (if-let [path (or (blank->nil (:swagger-file config))
                     (env "DATABASUS_SWAGGER_FILE"))]
     (read-json-file path)
     (parse-api-response
      (transport {:method :get
                  :url (swagger-url (api-root config))})))))

(defn effective-config [opts]
  {:transport (or (blank->nil (:transport opts))
                  (env "DATABASUS_TRANSPORT")
                  "direct")
   :ssh-host (or (blank->nil (:ssh-host opts))
                 (env "DATABASUS_SSH_HOST")
                 "sno-new")
   :vsock-cid (or (blank->nil (:vsock-cid opts))
                  (env "DATABASUS_VSOCK_CID")
                  "14")
   :guest-api-url (or (blank->nil (:guest-api-url opts))
                      (env "DATABASUS_GUEST_API_URL")
                      default-guest-api-url)
   :api-url (or (blank->nil (:api-url opts))
                (env "DATABASUS_API_URL"))
   :multiplex (or (blank->nil (:ssh-multiplex opts))
                  (blank->nil (:multiplex opts))
                  (env "DATABASUS_SSH_MULTIPLEX")
                  "auto")
   :control-persist (or (blank->nil (:ssh-control-persist opts))
                        (blank->nil (:control-persist opts))
                        (env "DATABASUS_SSH_CONTROL_PERSIST")
                        "300")
   :local-control-path (or (blank->nil (:local-control-path opts))
                           (env "DATABASUS_LOCAL_CONTROL_PATH"))
   :remote-control-path (or (blank->nil (:remote-control-path opts))
                            (env "DATABASUS_REMOTE_CONTROL_PATH")
                            "/run/databasus-cli-ssh/vsock-%C")
   :swagger-file (or (blank->nil (:swagger-file opts))
                     (env "DATABASUS_SWAGGER_FILE"))
   :token (or (blank->nil (:token opts))
              (env "DATABASUS_TOKEN"))})

(defn split-option-token [token]
  (let [raw (subs token 2)
        idx (str/index-of raw "=")]
    (if idx
      [(subs raw 0 idx) (subs raw (inc idx))]
      [raw nil])))

(defn parse-bool [value]
  (not (#{"false" "0" "no" "off"} (str/lower-case (str value)))))

(defn assoc-option [opts k v]
  (if (contains? opts k)
    (update opts k (fn [existing]
                     (if (vector? existing)
                       (conj existing v)
                       [existing v])))
    (assoc opts k v)))

(defn parse-cli-args [argv]
  (loop [tokens (seq argv)
         args []
         opts {}]
    (if-not (seq tokens)
      {:args args :opts opts}
      (let [token (first tokens)]
        (cond
          (= "--" token)
          {:args (into args (rest tokens)) :opts opts}

          (str/starts-with? token "--")
          (let [[raw-key inline-value] (split-option-token token)
                k (keyword (csk/->kebab-case-string raw-key))]
            (if (contains? boolean-options k)
              (recur (rest tokens)
                     args
                     (assoc-option opts k (if (nil? inline-value) true (parse-bool inline-value))))
              (if (some? inline-value)
                (recur (rest tokens) args (assoc-option opts k inline-value))
                (if-let [value (second tokens)]
                  (recur (nnext tokens) args (assoc-option opts k value))
                  (throw (ex-info (str "Missing value for --" raw-key) {:option k}))))))

          :else
          (recur (rest tokens) (conj args token) opts))))))

(defn mutating-handler? [handler]
  (not (contains? #{:get :head :options} (:method handler))))

(defn body-handler? [handler]
  (some? (:body-schema handler)))

(defn require-known-handler! [martian-instance route-name]
  (or (handler-for martian-instance route-name)
      (throw (ex-info (str "Unknown Databasus operation: " route-name)
                      {:route-name route-name}))))

(defn require-yes-for-mutation! [handler opts]
  (when (and (mutating-handler? handler)
             (not (:yes opts)))
    (throw (ex-info (str "Operation " (name (:route-name handler))
                         " uses " (str/upper-case (name (:method handler)))
                         " and requires --yes")
                    {:route-name (:route-name handler)
                     :method (:method handler)}))))

(defn read-json-payload [opts in]
  (let [raw (if-let [path (blank->nil (:json-file opts))]
              (slurp path)
              (slurp in))]
    (if-let [raw* (blank->nil raw)]
      (parse-json-body raw* (if (:json-file opts)
                              (str "JSON file " (:json-file opts))
                              "stdin"))
      (throw (ex-info "JSON payload required on stdin or with --json-file" {})))))

(defn operation-params
  ([opts handler in]
   (operation-params opts handler in nil))
  ([opts handler in payload]
   (cond-> (apply dissoc opts global-option-keys)
     (body-handler? handler) (assoc ::body (or payload (read-json-payload opts in))))))

(defn raw-swagger-parameters [handler]
  (or (get-in handler [:swagger-definition :parameters])
      (get-in handler ["swagger-definition" "parameters"])
      []))

(defn raw-parameter-name [parameter]
  (or (:name parameter) (get parameter "name")))

(defn raw-parameter-location [parameter]
  (or (:in parameter) (get parameter "in")))

(defn raw-parameter-required? [parameter]
  (true? (or (:required parameter) (get parameter "required"))))

(defn swagger-param-key [parameter]
  (keyword (str (raw-parameter-name parameter))))

(defn cli-param-key [parameter]
  (keyword (csk/->kebab-case-string (raw-parameter-name parameter))))

(defn normalize-cli-operation-params [handler params]
  (reduce (fn [params* parameter]
            (let [source-key (cli-param-key parameter)
                  target-key (swagger-param-key parameter)]
              (if (and (contains? params* source-key)
                       (not (contains? params* target-key)))
                (assoc params* target-key (get params* source-key))
                params*)))
          params
          (remove #(= "body" (raw-parameter-location %))
                  (raw-swagger-parameters handler))))

(defn param-present? [params config parameter]
  (let [name (raw-parameter-name parameter)
        location (raw-parameter-location parameter)
        target-key (swagger-param-key parameter)
        source-key (cli-param-key parameter)
        value (or (get params target-key) (get params source-key))]
    (cond
      (and (= "header" location)
           (= "authorization" (str/lower-case (str name))))
      (or (blank->nil (:token config)) (blank->nil value))

      :else
      (some? (blank->nil value)))))

(defn missing-param-message [parameter]
  (let [location (raw-parameter-location parameter)
        option (str "--" (csk/->kebab-case-string (raw-parameter-name parameter)))]
    (case location
      "header" (str "Missing required option --token for required header " (raw-parameter-name parameter))
      "path" (str "Missing required option " option)
      "query" (str "Missing required option " option)
      (str "Missing required option " option))))

(defn validate-required-operation-params! [handler params config]
  (doseq [parameter (raw-swagger-parameters handler)]
    (when (and (raw-parameter-required? parameter)
               (not= "body" (raw-parameter-location parameter))
               (not (param-present? params config parameter)))
      (throw (ex-info (missing-param-message parameter)
                      {:route-name (:route-name handler)
                       :parameter (raw-parameter-name parameter)
                       :in (raw-parameter-location parameter)})))))

(defn load-martian! [config transport]
  (bootstrap-martian (api-root config)
                     (load-swagger! config transport)))

(defn perform-operation-response!
  ([ctx route-name]
   (perform-operation-response! ctx route-name {}))
  ([{:keys [config transport in opts payload martian]} route-name {:keys [params response-as]}]
   (let [martian-instance (or martian (load-martian! config transport))
         handler (require-known-handler! martian-instance route-name)
         params* (normalize-cli-operation-params handler (or params (operation-params opts handler in payload)))]
     (require-yes-for-mutation! handler opts)
     (validate-required-operation-params! handler params* config)
     (-> (request-for-operation martian-instance route-name params* {:token (:token config)})
         (cond-> response-as (assoc :response-as response-as))
         transport))))

(defn perform-operation! [ctx route-name]
  (parse-api-response (perform-operation-response! ctx route-name)))

(defn printable-catalog [catalog]
  (sort-by (juxt :route-name :method :path) catalog))

(defn write-json-line! [out value]
  (.write out (json/generate-string value))
  (.write out "\n"))

(defn display-key [k]
  (-> (if (keyword? k) (name k) (str k))
      csk/->kebab-case-string
      (str/upper-case)
      (str/replace "-" "_")))

(defn display-cell [value]
  (cond
    (nil? value) ""
    (or (map? value) (sequential? value)) (json/generate-string value)
    :else (str value)))

(defn table-for-maps [rows]
  (let [ks (->> rows (mapcat keys) distinct (sort-by #(str (display-key %))))]
    (into [(mapv display-key ks)]
          (map (fn [row]
                 (mapv #(display-cell (get row %)) ks))
               rows))))

(declare write-table!)

(defn write-human-result! [out value]
  (cond
    (and (sequential? value) (every? map? value))
    (if (seq value)
      (write-table! out (table-for-maps value))
      (.write out "No results\n"))

    :else
    (write-json-line! out value)))

(defn write-result! [out json? value]
  (cond
    json? (write-json-line! out value)
    (nil? value) nil
    (string? value) (do (.write out value) (.write out "\n"))
    :else (write-human-result! out value)))

(defn write-ops! [out json? catalog]
  (let [catalog* (vec (printable-catalog catalog))]
    (if json?
      (write-json-line! out catalog*)
      (do
        (.write out
                (cli/format-table
                 {:indent 0
                  :rows (into [["ROUTE" "METHOD" "PATH" "SUMMARY"]]
                              (map (fn [{:keys [route-name method path summary]}]
                                     [(name route-name)
                                      (str/upper-case (name method))
                                      path
                                      (or summary "")])
                                   catalog*))}))
        (.write out "\n")))))

(defn positional! [positionals idx usage]
  (or (nth positionals idx nil)
      (throw (ex-info usage {:usage usage}))))

(defn require-option! [opts k usage]
  (or (blank->nil (get opts k))
      (throw (ex-info usage {:usage usage :option k}))))

(defn with-command-opts [ctx extra-opts]
  (update ctx :opts merge extra-opts))

(defn with-payload [ctx payload]
  (assoc ctx :payload payload))

(defn parse-int-option [value option-name]
  (try
    (parse-long (str value))
    (catch Exception _
      (throw (ex-info (str "Invalid integer for " option-name ": " value)
                      {:option option-name
                       :value value})))))

(defn trim-file [path]
  (str/trim (slurp path)))

(defn postgres-database-payload [opts]
  (let [usage "Usage: scripts/databasus database create-postgres --name <name> --workspace-id <workspace-id> --host <host> --database <database> --username <username> --password-file <path> --yes [--json]"
        password-file (require-option! opts :password-file usage)]
    {"name" (require-option! opts :name usage)
     "workspaceId" (require-option! opts :workspace-id usage)
     "type" "POSTGRES_LOGICAL"
     "postgresql" {"host" (require-option! opts :host usage)
                   "port" (parse-int-option (or (:port opts) "5432") "--port")
                   "database" (require-option! opts :database usage)
                   "username" (require-option! opts :username usage)
                   "password" (trim-file password-file)
                   "sslMode" (or (blank->nil (:ssl-mode opts)) "disable")
                   "version" (or (blank->nil (:version opts)) "17")
                   "backupType" (or (blank->nil (:backup-type opts)) "PG_DUMP")
                   "cpuCount" (parse-int-option (or (:cpu-count opts) "1") "--cpu-count")}}))

(defn daily-backup-config-payload [database-id opts]
  (let [usage "Usage: scripts/databasus backup-config daily <database-id> --storage-id <storage-id> --time <HH:MM> --yes [--json]"
        storage-id (require-option! opts :storage-id usage)
        retention-count (parse-int-option (or (:retention-count opts) "100") "--retention-count")
        max-failed (parse-int-option (or (:max-failed-tries opts) "3") "--max-failed-tries")]
    {"databaseId" database-id
     "storageId" storage-id
     "storage" {"id" storage-id}
     "isBackupsEnabled" true
     "backupInterval" {"type" "DAILY"
                       "timeOfDay" (require-option! opts :time usage)}
     "retentionPolicyType" "TIME_PERIOD"
     "retentionTimePeriod" (or (blank->nil (:retention opts)) "3_MONTH")
     "retentionCount" retention-count
     "retentionGfsYears" 3
     "retentionGfsMonths" 12
     "retentionGfsWeeks" 4
     "retentionGfsDays" 7
     "retentionGfsHours" 24
     "encryption" (or (blank->nil (:encryption opts)) "ENCRYPTED")
     "isRetryIfFailed" true
     "maxFailedTriesCount" max-failed
     "sendNotificationsOn" ["BACKUP_FAILED"]}))

(defn hourly-gfs-backup-config-payload [database-id opts]
  (let [usage "Usage: scripts/databasus backup-config hourly-gfs <database-id> --storage-id <storage-id> [--time <HH:MM>] --yes [--json]"
        storage-id (require-option! opts :storage-id usage)
        retention-count (parse-int-option (or (:retention-count opts) "100") "--retention-count")
        max-failed (parse-int-option (or (:max-failed-tries opts) "3") "--max-failed-tries")]
    {"databaseId" database-id
     "storageId" storage-id
     "storage" {"id" storage-id}
     "isBackupsEnabled" true
     "backupInterval" {"type" "HOURLY"
                       "timeOfDay" (or (blank->nil (:time opts)) "00:00")}
     "retentionPolicyType" "GFS"
     "retentionTimePeriod" (or (blank->nil (:retention opts)) "3_MONTH")
     "retentionCount" retention-count
     "retentionGfsYears" (parse-int-option (or (:gfs-years opts) "3") "--gfs-years")
     "retentionGfsMonths" (parse-int-option (or (:gfs-months opts) "12") "--gfs-months")
     "retentionGfsWeeks" (parse-int-option (or (:gfs-weeks opts) "4") "--gfs-weeks")
     "retentionGfsDays" (parse-int-option (or (:gfs-days opts) "7") "--gfs-days")
     "retentionGfsHours" (parse-int-option (or (:gfs-hours opts) "24") "--gfs-hours")
     "encryption" (or (blank->nil (:encryption opts)) "ENCRYPTED")
     "isRetryIfFailed" true
     "maxFailedTriesCount" max-failed
     "sendNotificationsOn" ["BACKUP_FAILED"]}))

(def backup-config-policy-keys
  ["storageId"
   "isBackupsEnabled"
   "backupInterval"
   "retentionPolicyType"
   "retentionTimePeriod"
   "retentionCount"
   "retentionGfsYears"
   "retentionGfsMonths"
   "retentionGfsWeeks"
   "retentionGfsDays"
   "retentionGfsHours"
   "encryption"
   "isRetryIfFailed"
   "maxFailedTriesCount"
   "sendNotificationsOn"])

(defn backup-config-storage-id [config]
  (or (blank->nil (get config "storageId"))
      (blank->nil (get-in config ["storage" "id"]))))

(defn clone-backup-config-payload [source-config target-database-id]
  (let [storage-id (or (backup-config-storage-id source-config)
                       (throw (ex-info "Source backup config did not include storageId or storage.id"
                                       {:source-database-id (get source-config "databaseId")})))]
    (assoc (select-keys source-config backup-config-policy-keys)
           "databaseId" target-database-id
           "storageId" storage-id
           "storage" {"id" storage-id})))

(defn require-option-any! [opts ks usage]
  (or (some #(blank->nil (get opts %)) ks)
      (throw (ex-info usage {:usage usage :options ks}))))

(defn clone-backup-config! [ctx source-database-id target-database-id]
  (when-not (get-in ctx [:opts :yes])
    (throw (ex-info "Operation backup-config clone-policy uses POST and requires --yes"
                    {:command "backup-config clone-policy"
                     :method :post})))
  (let [martian-instance (load-martian! (:config ctx) (:transport ctx))
        ctx* (assoc ctx :martian martian-instance)
        source-config (perform-operation! (with-command-opts ctx* {:id source-database-id
                                                                   :database-id source-database-id})
                                          :get-backup-configs-database-id)
        payload (clone-backup-config-payload source-config target-database-id)]
    (perform-operation! (-> ctx*
                            (assoc :opts {:yes true})
                            (with-payload payload))
                        :post-backup-configs-save)))

(defn write-lines! [out lines]
  (doseq [line (remove nil? lines)]
    (.write out (str line "\n"))))

(defn write-table! [out rows]
  (.write out (cli/format-table {:indent 0 :rows rows}))
  (.write out "\n"))

