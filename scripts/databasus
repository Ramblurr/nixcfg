(defn write-ops-help! [out]
  (write-lines!
   out
   ["Usage: scripts/databasus ops [--json]"
    ""
    "List the operation catalog generated from the Databasus Swagger document."
    ""
    "Options:"
    "  --json                 Print catalog as JSON"
    "  --swagger-file <path>  Load Swagger from a local fixture"]))

(defn schema-ref-name [ref]
  (when-let [ref* (blank->nil ref)]
    (last (str/split ref* #"/"))))

(defn schema-type [schema]
  (or (:type schema)
      (get schema "type")
      (some-> (or (:$ref schema) (get schema :$ref) (get schema "$ref")) schema-ref-name)
      "object"))

(defn parameter-name [parameter]
  (or (:name parameter) (get parameter "name")))

(defn parameter-location [parameter]
  (or (:in parameter) (get parameter "in")))

(defn parameter-description [parameter]
  (or (:description parameter) (get parameter "description") ""))

(defn parameter-required? [parameter]
  (true? (or (:required parameter) (get parameter "required"))))

(defn parameter-type [parameter]
  (or (:type parameter)
      (get parameter "type")
      (schema-type (or (:schema parameter) (get parameter "schema")))))

(defn swagger-parameters [handler]
  (or (get-in handler [:swagger-definition :parameters])
      (get-in handler ["swagger-definition" "parameters"])
      []))

(defn cli-parameter-name [parameter]
  (let [location (parameter-location parameter)
        name (parameter-name parameter)]
    (case location
      "body" "stdin JSON / --json-file"
      "positional" (str "<" (csk/->kebab-case-string name) ">")
      (str "--" (csk/->kebab-case-string name)))))

(defn parameter-rows [parameters]
  (into [["PARAMETER" "IN" "TYPE" "REQUIRED" "DESCRIPTION"]]
        (map (fn [parameter]
               [(cli-parameter-name parameter)
                (or (parameter-location parameter) "")
                (parameter-type parameter)
                (if (parameter-required? parameter) "required" "optional")
                (parameter-description parameter)])
             parameters)))

(defn operation-usage [route-name handler]
  (let [params (swagger-parameters handler)
        non-body-required (filter #(and (parameter-required? %)
                                        (not= "body" (parameter-location %)))
                                  params)
        body? (some #(= "body" (parameter-location %)) params)]
    (str "scripts/databasus op " (name (route-key route-name))
         (apply str
                (map (fn [parameter]
                       (str " " (cli-parameter-name parameter) " <"
                            (csk/->kebab-case-string (parameter-name parameter)) ">"))
                     non-body-required))
         (when body? " --yes [--json-file <path>]")
         " [--json]")))

(defn write-operation-help!
  ([out usage handler]
   (write-operation-help! out usage handler {}))
  ([out usage handler options]
   (let [route-name (:route-name handler)
         method (str/upper-case (name (:method handler)))
         path (:path handler)
         summary (:summary handler)
         params (or (:parameters options) (swagger-parameters handler))
         yes-required? (if (contains? options :yes-required?)
                         (:yes-required? options)
                         (mutating-handler? handler))
         body-option? (and (body-handler? handler)
                           (not (:parameters options)))]
     (write-lines!
      out
      [(str "Usage: " usage)
       ""
       (str "Generated route: " (name route-name))
       (str method " " path)
       (or summary "")
       ""
       "Parameters:"])
     (if (seq params)
       (write-table! out (parameter-rows params))
       (write-lines! out ["  none"]))
     (write-lines!
      out
      [""
       "Common options:"
       "  --json                 Print parsed response as JSON"
       "  --swagger-file <path>  Load Swagger from a local fixture"
       (when yes-required?
         "  --yes                  Required for mutating generated operations")
       (when body-option?
         "  --json-file <path>    Read JSON body from a file instead of stdin")])
     (when-let [notes (seq (:notes options))]
       (write-lines! out (cons "" notes))))))

