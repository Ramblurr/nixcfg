(defn alias-help-entry [positionals]
  (or (get alias-help (vec (take 2 positionals)))
      (get alias-help (vec (take 1 positionals)))))

(defn write-op-help! [out config transport positionals]
  (if-let [route-name (second positionals)]
    (let [martian-instance (load-martian! config transport)
          handler (require-known-handler! martian-instance route-name)]
      (write-operation-help! out (operation-usage route-name handler) handler))
    (write-lines!
     out
     ["Usage: scripts/databasus op <route-name> [options]"
      ""
      "Call any operation generated from the Databasus Swagger document."
      "Run `scripts/databasus ops` to list route names."
      "Run `scripts/databasus op <route-name> --help` for operation parameters."])))

(defn write-alias-help! [out config transport entry]
  (let [martian-instance (load-martian! config transport)
        handler (require-known-handler! martian-instance (:route entry))]
    (write-operation-help! out (:usage entry) handler entry)))

(defn write-help! [out config transport positionals]
  (let [command (first positionals)]
    (cond
      (nil? command)
      (write-top-level-help! out)

      (= "ops" command)
      (write-ops-help! out)

      (= "op" command)
      (write-op-help! out config transport positionals)

      (alias-help-entry positionals)
      (write-alias-help! out config transport (alias-help-entry positionals))

      :else
      (write-top-level-help! out))))

(defn response-token [value]
  (or (get value "token")
      (get value :token)
      (get value "download_token")
      (get value :download-token)
      (get value "downloadToken")
      (get value :downloadToken)))

(defn write-bytes-file! [path bytes]
  (let [file (java.io.File. path)]
    (when-let [parent (.getParentFile file)]
      (.mkdirs parent))
    (with-open [out (java.io.FileOutputStream. file)]
      (.write out bytes))))

(defn raw-api-request! [ctx method path]
  (parse-api-response
   ((:transport ctx)
    {:method method
     :url (str (api-root (:config ctx)) path)
     :headers (cond-> {}
                (blank->nil (get-in ctx [:config :token]))
                (assoc "Authorization" (get-in ctx [:config :token])))})))

(defn backup-download! [ctx backup-id output-path]
  (let [martian-instance (load-martian! (:config ctx) (:transport ctx))
        ctx* (assoc ctx :martian martian-instance)
        token-response (perform-operation!
                        (with-command-opts ctx* {:id backup-id :yes true})
                        :post-backups-id-download-token)
        token (or (response-token token-response)
                  (throw (ex-info "Download token response did not contain a token"
                                  {:response token-response})))
        response (perform-operation-response!
                  ctx*
                  :get-backups-id-file
                  {:params {:id backup-id :token token}
                   :response-as :bytes})
        bytes (or (:body-bytes response)
                  (.getBytes (or (:body response) "") "UTF-8"))]
    (when-not (<= 200 (:status response) 299)
      (parse-api-response response))
    (write-bytes-file! output-path bytes)
    {:output output-path
     :backup_id backup-id
     :bytes (alength bytes)}))

(defn run-cli!
  ([argv]
   (run-cli! argv {}))
  ([argv {:keys [transport out in]
          :or {out *out*
               in *in*}}]
   (let [{positionals :args opts :opts} (parse-cli-args argv)
         command (first positionals)
         config (effective-config opts)
         transport* (or transport (make-transport config))
         ctx {:config config
              :transport transport*
              :out out
              :in in
              :opts opts}
         json? (:json opts)]
     (if (or (:help opts) (nil? command))
       (write-help! out config transport* positionals)
       (case command
         "ops"
         (write-ops! out json? (operation-catalog (load-martian! config transport*)))

         "op"
         (let [route-name (second positionals)]
           (when-not route-name
             (throw (ex-info "Usage: scripts/databasus op <route-name>" {})))
           (write-result! out json? (perform-operation! ctx route-name)))

         "health"
         (write-result! out json? (perform-operation! ctx :get-system-health))

         "version"
         (write-result! out json? (perform-operation! ctx :get-system-version))

         "swagger"
         (write-result! out true (load-swagger! config transport*))

         "workspaces"
         (write-result! out json? (perform-operation! ctx :get-workspaces))

         "databases"
         (write-result! out json? (perform-operation! ctx :get-databases))

         "database"
         (let [subcommand (second positionals)]
           (case subcommand
             "get"
             (let [database-id (positional! positionals 2
                                            "Usage: scripts/databasus database get <database-id>")]
               (write-result! out json?
                              (perform-operation! (with-command-opts ctx {:id database-id
                                                                          :database-id database-id})
                                                  :get-databases-id)))

             "create"
             (write-result! out json? (perform-operation! ctx :post-databases-create))

             "create-postgres"
             (write-result! out json?
                            (perform-operation! (-> ctx
                                                    (assoc :opts {:yes (:yes opts)})
                                                    (with-payload (postgres-database-payload opts)))
                                                :post-databases-create))

             "update"
             (write-result! out json? (perform-operation! ctx :post-databases-update))

             "delete"
             (let [database-id (positional! positionals 2
                                            "Usage: scripts/databasus database delete <database-id> --yes")]
               (when-not (:yes opts)
                 (throw (ex-info "Operation database delete uses DELETE and requires --yes" {})))
               (write-result! out json?
                              (if-let [_handler (handler-for (load-martian! config transport*) :delete-databases-id)]
                                (perform-operation! (with-command-opts ctx {:id database-id
                                                                            :database-id database-id})
                                                    :delete-databases-id)
                                (raw-api-request! ctx :delete (str "/databases/" (urlencode database-id))))))

             (throw (ex-info (str "Unknown Databasus database command: " (or subcommand "<none>"))
                             {:command subcommand}))))

         "storages"
         (write-result! out json? (perform-operation! ctx :get-storages))

         "storage"
         (let [subcommand (second positionals)]
           (case subcommand
             "get"
             (let [storage-id (positional! positionals 2
                                           "Usage: scripts/databasus storage get <storage-id>")]
               (write-result! out json?
                              (perform-operation! (with-command-opts ctx {:id storage-id
                                                                          :storage-id storage-id})
                                                  :get-storages-id)))

             "save"
             (write-result! out json? (perform-operation! ctx :post-storages))

             "delete"
             (let [storage-id (positional! positionals 2
                                           "Usage: scripts/databasus storage delete <storage-id> --yes")]
               (write-result! out json?
                              (perform-operation! (with-command-opts ctx {:id storage-id
                                                                          :storage-id storage-id})
                                                  :delete-storages-id)))

             (throw (ex-info (str "Unknown Databasus storage command: " (or subcommand "<none>"))
                             {:command subcommand}))))

         "notifiers"
         (write-result! out json? (perform-operation! ctx :get-notifiers))

         "notifier"
         (let [subcommand (second positionals)]
           (case subcommand
             "get"
             (let [notifier-id (positional! positionals 2
                                            "Usage: scripts/databasus notifier get <notifier-id>")]
               (write-result! out json?
                              (perform-operation! (with-command-opts ctx {:id notifier-id
                                                                          :notifier-id notifier-id})
                                                  :get-notifiers-id)))

             "save"
             (write-result! out json? (perform-operation! ctx :post-notifiers))

             "delete"
             (let [notifier-id (positional! positionals 2
                                            "Usage: scripts/databasus notifier delete <notifier-id> --yes")]
               (write-result! out json?
                              (perform-operation! (with-command-opts ctx {:id notifier-id
                                                                          :notifier-id notifier-id})
                                                  :delete-notifiers-id)))

             (throw (ex-info (str "Unknown Databasus notifier command: " (or subcommand "<none>"))
                             {:command subcommand}))))

         "disk"
         (let [subcommand (second positionals)]
           (case subcommand
             "usage"
             (write-result! out json? (perform-operation! ctx :get-disk-usage))

             (throw (ex-info (str "Unknown Databasus disk command: " (or subcommand "<none>"))
                             {:command subcommand}))))

         "backups"
         (write-result! out json? (perform-operation! ctx :get-backups))

         "backup-config"
         (let [subcommand (second positionals)]
           (case subcommand
             "get"
             (let [database-id (positional! positionals 2
                                            "Usage: scripts/databasus backup-config get <database-id>")]
               (write-result! out json?
                              (perform-operation! (with-command-opts ctx {:id database-id
                                                                          :database-id database-id})
                                                  :get-backup-configs-database-id)))

             "save"
             (write-result! out json?
                            (perform-operation! ctx :post-backup-configs-save))

             "daily"
             (let [database-id (positional! positionals 2
                                            "Usage: scripts/databasus backup-config daily <database-id> --storage-id <storage-id> --time <HH:MM> --yes")]
               (write-result! out json?
                              (perform-operation! (-> ctx
                                                      (assoc :opts {:yes (:yes opts)})
                                                      (with-payload (daily-backup-config-payload database-id opts)))
                                                  :post-backup-configs-save)))

             "hourly-gfs"
             (let [database-id (positional! positionals 2
                                            "Usage: scripts/databasus backup-config hourly-gfs <database-id> --storage-id <storage-id> [--time <HH:MM>] --yes")]
               (write-result! out json?
                              (perform-operation! (-> ctx
                                                      (assoc :opts {:yes (:yes opts)})
                                                      (with-payload (hourly-gfs-backup-config-payload database-id opts)))
                                                  :post-backup-configs-save)))

             "clone-policy"
             (let [usage "Usage: scripts/databasus backup-config clone-policy --from-db-id <source-database-id> --to-db-id <target-database-id> --yes"
                   source-database-id (require-option-any! opts [:from-db-id :from-database-id] usage)
                   target-database-id (require-option-any! opts [:to-db-id :to-database-id] usage)]
               (write-result! out json?
                              (clone-backup-config! ctx source-database-id target-database-id)))

             (throw (ex-info (str "Unknown Databasus backup-config command: " (or subcommand "<none>"))
                             {:command subcommand}))))

         "backup"
         (let [subcommand (second positionals)]
           (case subcommand
             "run"
             (let [database-id (positional! positionals 2
                                            "Usage: scripts/databasus backup run <database-id>")
                   ctx* (-> ctx
                            (with-command-opts {:yes true})
                            (with-payload {"database_id" database-id}))]
               (write-result! out json? (perform-operation! ctx* :post-backups)))

             "download"
             (let [backup-id (positional! positionals 2
                                          "Usage: scripts/databasus backup download <backup-id> --output <path>")
                   output-path (require-option! opts :output
                                                "Usage: scripts/databasus backup download <backup-id> --output <path>")]
               (write-result! out json? (backup-download! ctx backup-id output-path)))

             "cancel"
             (let [backup-id (positional! positionals 2
                                          "Usage: scripts/databasus backup cancel <backup-id> --yes")]
               (write-result! out json?
                              (perform-operation! (with-command-opts ctx {:id backup-id
                                                                          :backup-id backup-id})
                                                  :post-backups-id-cancel)))

             "delete"
             (let [backup-id (positional! positionals 2
                                          "Usage: scripts/databasus backup delete <backup-id> --yes")]
               (write-result! out json?
                              (perform-operation! (with-command-opts ctx {:id backup-id
                                                                          :backup-id backup-id})
                                                  :delete-backups-id)))

             (throw (ex-info (str "Unknown Databasus backup command: " (or subcommand "<none>"))
                             {:command subcommand}))))

         "restores"
         (let [backup-id (require-option! opts :backup-id
                                          "Usage: scripts/databasus restores --backup-id <backup-id>")]
           (write-result! out json?
                          (perform-operation! (with-command-opts ctx {:backup-id backup-id})
                                              :get-restores-backup-id)))

         "restore"
         (let [subcommand (second positionals)]
           (case subcommand
             "run"
             (let [backup-id (positional! positionals 2
                                          "Usage: scripts/databasus restore run <backup-id> --yes")]
               (write-result! out json?
                              (perform-operation! (with-command-opts ctx {:backup-id backup-id})
                                                  :post-restores-backup-id-restore)))

             "cancel"
             (let [restore-id (positional! positionals 2
                                           "Usage: scripts/databasus restore cancel <restore-id> --yes")]
               (write-result! out json?
                              (perform-operation! (with-command-opts ctx {:restore-id restore-id})
                                                  :post-restores-cancel-restore-id)))

             (throw (ex-info (str "Unknown Databasus restore command: " (or subcommand "<none>"))
                             {:command subcommand}))))

         (throw (ex-info (str "Unknown Databasus command: " (or command "<none>"))
                         {:command command}))))
     (.flush out)
     0)))

(defn -main [& args]
  (try
    (System/exit (run-cli! args))
    (catch Exception e
      (binding [*out* *err*]
        (println (ex-message e)))
      (System/exit 1))))

(when (= *file* (System/getProperty "babashka.file"))
  (apply -main *command-line-args*))
