#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: check-onepassword-connect-token HOST [OP_REFERENCE ...]

Checks HOST's /run/secrets/onepassword-connect-token against the Connect VIP.
With no references, checks token authentication by listing accessible vaults.
With references, verifies that each value can be read without printing it.

Override the endpoint with OP_CONNECT_HOST.
EOF
  exit 2
}

(( $# >= 1 )) || usage
host=$1
shift

[[ $host =~ ^[A-Za-z0-9._-]+$ ]] || {
  echo "Invalid host: $host" >&2
  exit 2
}

connect_host=${OP_CONNECT_HOST:-http://10.9.8.22:8080}
printf -v remote_args ' %q' "$connect_host" "$@"

ssh -o BatchMode=yes -- "$host" "sudo -n bash -s --$remote_args" <<'REMOTE'
set -euo pipefail

connect_host=$1
shift
token_file=/run/secrets/onepassword-connect-token
provider_unit=/etc/systemd/system/onepassword-credential-provider@.service

[[ -r $token_file ]] || {
  echo "Token file is not readable: $token_file" >&2
  exit 1
}

provider=$(sed -n 's/^ExecStart=//p' "$provider_unit")
op=$(grep -o '/nix/store/[^" ]*/bin/op' "$provider" | head -1)
[[ -x $op ]] || {
  echo "Could not locate the provider's 1Password CLI" >&2
  exit 1
}

token=$(<"$token_file")
[[ -n $token ]] || {
  echo "Token file is empty: $token_file" >&2
  exit 1
}

export OP_CACHE=false
export OP_CONNECT_HOST="$connect_host"
export OP_CONNECT_TOKEN="$token"

if (( $# == 0 )); then
  if "$op" vault list --format json >/dev/null; then
    echo "Connect token: OK"
  else
    echo "Connect token: FAILED" >&2
    exit 1
  fi
  exit 0
fi

status=0
for reference in "$@"; do
  if "$op" read --no-newline "$reference" >/dev/null; then
    echo "$reference: OK"
  else
    echo "$reference: FAILED" >&2
    status=1
  fi
done
exit "$status"
REMOTE
