(ns harness-plugins-sync.terminal
  "Colors, status messages and a progress spinner for CLI applications.

  Messages and progress go to stderr. [[style]] decorates text for stdout.
  `harness-plugins-sync.cli/run` binds [[*terminal*]] for each invocation, so
  application code needs no checks for pipes, `NO_COLOR`, `TERM=dumb` or
  `--json`/`--edn` modes. sugar picks colors for the terminal's color level and
  background and turns them off for pipes, `NO_COLOR` and `TERM=dumb`."
  (:require
   [sugar.core :as sugar]
   [supports-color.core :as supports-color]))

(def ^:private tty-err?
  ;; Only the spinner needs this: NO_COLOR removes color, not animation.
  ;; Neither the JVM nor Babashka can test one descriptor, so ask a POSIX shell.
  (delay
    (try
      (-> (ProcessBuilder. ^java.util.List ["sh" "-c" "[ -t 2 ]"])
          (.redirectError java.lang.ProcessBuilder$Redirect/INHERIT)
          .start .waitFor zero?)
      (catch Exception _ false))))

(defn detect
  "Returns terminal capabilities: `:color-out?`, `:color-err?` and `:animate?`.

  `structured?` is true in `--json`/`--edn` modes, which turn all three off.
  Otherwise sugar decides stdout color, supports-color decides stderr color, and
  the spinner runs when stderr is a terminal and `TERM` is not `dumb`."
  [structured?]
  (if structured?
    {:color-out? false :color-err? false :animate? false}
    {:color-out? true
     :color-err? (pos? (:level (supports-color/profile {:stream :stderr})))
     :animate?   (and (not= "dumb" (System/getenv "TERM")) @tty-err?)}))

(def ^:dynamic *terminal*
  "Terminal capabilities from [[detect]]. Nil outside `harness-plugins-sync.cli/run`,
  where functions detect them from the process environment."
  nil)

(defn- terminal []
  (or *terminal* (detect false)))

(def ^:private roles
  {:ok :green :warn :yellow :error :red :info :blue :dim :gray :bold :bold :heading :bold.blue})

(defn- paint
  "Returns `text` styled for a role or any sugar style unless `color?` is false.
  sugar checks only stdout, so stderr text is plain when stdout is redirected."
  [color? role-or-style text]
  (if color?
    (sugar/styled (str text) (roles role-or-style role-or-style))
    (str text)))

(defn style
  "Returns `text` decorated when stdout supports color.

  `role` is `:ok`, `:warn`, `:error`, `:info`, `:dim`, `:bold` or `:heading`, or
  any sugar style such as `:bold.magenta` or `{:color \"#ff5f00\"}`. Keep
  meaning in the words; color only aids scanning."
  [role text]
  (paint (:color-out? (terminal)) role text))

(def ^:private lock (Object.))

(defonce ^:private !active (atom nil))

(def ^:private erase-line "\r\u001b[2K")
(def ^:private hide-cursor "\u001b[?25l")
(def ^:private show-cursor "\u001b[?25h")

(defn- write-err! [^String s]
  (locking lock
    (.write *err* s)
    (.flush *err*)))

(defn- message! [role label text]
  (let [color? (:color-err? (terminal))
        line   (str (when label (str (paint color? role label) " ")) text "\n")]
    (locking lock
      (when @!active (.write *err* ^String erase-line))
      (.write *err* ^String line)
      (.flush *err*))))

(defn info "Prints an informational message to stderr." [text] (message! :info nil text))
(defn success "Prints `ok: text` to stderr." [text] (message! :ok "ok:" text))
(defn warn "Prints `warning: text` to stderr." [text] (message! :warn "warning:" text))
(defn error "Prints `error: text` to stderr." [text] (message! :error "error:" text))

;; Dots frames from cli-spinners, MIT License,
;; Copyright (c) Sindre Sorhus <sindresorhus@gmail.com>. See NOTICE.
(def ^:private frames ["⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏"])

(def ^:private restore-on-exit
  (delay
    (.addShutdownHook
     (Runtime/getRuntime)
     (Thread. ^Runnable
              (fn []
                (when-let [state @!active]
                  (locking lock
                    (.print System/err (str erase-line (:title @state) ": interrupted\n" show-cursor))
                    (.flush System/err))))))))

(defn- spinner-thread [state ^java.io.Writer err]
  (doto (Thread.
         ^Runnable
         (fn []
           (try
             (loop [i 0]
               (when (:running? @state)
                 (locking lock
                   (.write err (str erase-line (paint (:color? @state) :info (frames i))
                                    " " (:label @state)))
                   (.flush err))
                 (Thread/sleep 80)
                 (recur (mod (inc i) (count frames)))))
             (catch InterruptedException _ nil))))
    (.setDaemon true)
    (.start)))

(def ^:dynamic ^:private *progress*
  "State atom for the innermost [[with-progress]] in this thread."
  nil)

(defn step
  "Reports a new phase of the current [[with-progress]] operation.
  Updates the spinner label, or prints a plain line when not animated."
  [text]
  (if (and *progress* (= *progress* @!active))
    (swap! *progress* assoc :label text)
    (info text)))

(defn- elapsed [start]
  (format "%.1fs" (/ (- (System/nanoTime) start) 1e9)))

(defn call-with-progress
  "Calls `f` while showing `label` as progress on stderr. Returns or throws as `f` does.

  Animates a spinner only for one operation at a time on an interactive stderr.
  Nested or concurrent calls, pipes, `TERM=dumb` and structured modes print plain
  lines instead. Stops the spinner and restores the cursor before returning."
  [label f]
  (let [{:keys [animate? color-err?]} (terminal)
        state (atom {:title label :label label :running? true :color? color-err?})
        start (System/nanoTime)
        own?  (and animate? (compare-and-set! !active nil state))]
    (if-not own?
      (do (info (str label "..."))
          (binding [*progress* state]
            (let [result (try (f)
                              (catch Throwable t
                                (message! :error nil (str label ": failed"))
                                (throw t)))]
              (message! :ok nil (str label ": done (" (elapsed start) ")"))
              result)))
      (let [_      @restore-on-exit
            _      (write-err! hide-cursor)
            thread (spinner-thread state *err*)
            stop!  (fn [role text]
                     (swap! state assoc :running? false)
                     (.interrupt ^Thread thread)
                     (.join ^Thread thread 1000)
                     (locking lock
                       (reset! !active nil)
                       (.write *err* (str erase-line (paint color-err? role text) "\n" show-cursor))
                       (.flush *err*)))]
        (try
          (let [result (binding [*progress* state] (f))]
            (stop! :ok (str "✓ " label ": done (" (elapsed start) ")"))
            result)
          (catch Throwable t
            (stop! :error (str "✗ " label ": failed"))
            (throw t))
          (finally
            (when (= state @!active)
              (reset! !active nil)
              (write-err! show-cursor))))))))

(defmacro with-progress
  "Evaluates `body` while showing `label` as progress. See [[call-with-progress]]."
  [label & body]
  `(call-with-progress ~label (fn [] ~@body)))
(ns harness-plugins-sync.remote
  "Fans out `harness-plugins-sync` commands to remote peer hosts over SSH."
  (:require
   [babashka.process :as proc]
   [clojure.data.json :as json]
   [clojure.java.io :as io]
   [clojure.string :as str])
  (:import
   java.net.InetAddress
   java.util.concurrent.TimeUnit))

(def default-timeout-ms
  "Default per-peer SSH wall-clock timeout in milliseconds."
  15000)

(def ^:private tailscale-auth-pattern
  #"(https://login\.tailscale\.com/\S+)")

(defn extract-auth-url
  "Extracts a Tailscale SSH auth URL from `s`, or returns nil."
  [s]
  (when-let [[_ url] (re-find tailscale-auth-pattern (str s))]
    (str/replace url #"[.,;:)\]]+$" "")))

(defn local-hostname
  "Returns the short local hostname."
  []
  (try
    (-> (InetAddress/getLocalHost)
        .getHostName
        (str/split #"\.")
        first)
    (catch Exception _
      (or (System/getenv "HOSTNAME") "localhost"))))

(defn local-username
  "Returns the current OS username."
  []
  (or (System/getenv "USER") (System/getProperty "user.name") ""))

(defn- peer-host [spec]
  (let [s (str spec)
        i (str/index-of s "@")]
    (if i (subs s (inc i)) s)))

(defn- peer-user [spec]
  (let [s (str spec)
        i (str/index-of s "@")]
    (when i (subs s 0 i))))

(defn- local-peer? [spec self-host self-user]
  (and (= (peer-host spec) self-host)
       (let [u (peer-user spec)]
         (or (nil? u) (= u self-user)))))

(defn target-plan
  "Computes `{:local? bool :remotes [host ...]}` from `peers`, `all?`, `hosts`,
  and `self-host` (matching optional `user@host` peers against `self-user`)."
  ([peers all? hosts self-host]
   (target-plan peers all? hosts self-host (local-username)))
  ([peers all? hosts self-host self-user]
   (let [explicit (vec (distinct hosts))]
     (cond
       (seq explicit)
       {:local?  (boolean (some #(local-peer? % self-host self-user) explicit))
        :remotes (vec (remove #(local-peer? % self-host self-user) explicit))}

       all?
       {:local?  true
        :remotes (vec (distinct (remove #(local-peer? % self-host self-user) peers)))}

       :else
       {:local? true :remotes []}))))

(defn forward-flags
  "Builds CLI arguments forwarded to a remote `harness-plugins-sync` invocation."
  [subcmd {:keys [pack profile force dry-run]}]
  (cond-> ["harness-plugins-sync" subcmd "--json"]
    (seq pack)    (into (mapcat #(vector "--pack" %) pack))
    (seq profile) (into (mapcat #(vector "--profile" %) profile))
    force         (conj "--force")
    dry-run       (conj "--dry-run")))

(defn- read-stream-async [stream on-line]
  (let [lines (atom [])
        t     (Thread.
               ^Runnable
               (fn []
                 (try
                   (with-open [r (io/reader stream)]
                     (loop []
                       (when-let [line (.readLine r)]
                         (swap! lines conj line)
                         (when on-line (on-line line))
                         (recur))))
                   (catch Exception _ nil))))]
    (.setDaemon t true)
    (.start t)
    {:thread t :lines lines}))

(defn run-remote
  "Runs `subcmd` on remote `host` via SSH and returns a structured peer result.

  Fails fast when Tailscale SSH emits an interactive auth URL on stderr or
  stdout, killing the stalled SSH process and returning `:status :auth-required`
  with `:auth-url`. Enforces `timeout-ms` (default 15000 ms)."
  ([ssh-bin host subcmd input]
   (run-remote ssh-bin host subcmd input default-timeout-ms))
  ([ssh-bin host subcmd input timeout-ms]
   (let [remote-argv (forward-flags subcmd input)
         ssh-args    (into [ssh-bin "-o" "BatchMode=yes" "-o" "ConnectTimeout=5" host]
                           remote-argv)
         p           (proc/process ssh-args {:out :stream :err :stream})
         ^Process jp (:proc p)
         auth-url    (promise)
         on-line     (fn [line]
                       (when-let [url (extract-auth-url line)]
                         (deliver auth-url url)
                         (.destroyForcibly jp)))
         out-reader  (read-stream-async (:out p) on-line)
         err-reader  (read-stream-async (:err p) on-line)
         finished?   (.waitFor jp (long timeout-ms) TimeUnit/MILLISECONDS)]
     (when-not finished?
       (.destroyForcibly jp)
       (.waitFor jp 2 TimeUnit/SECONDS))
     (.join ^Thread (:thread out-reader) 1000)
     (.join ^Thread (:thread err-reader) 1000)
     (let [out-str (str/join "\n" @(:lines out-reader))
           err-str (str/join "\n" @(:lines err-reader))
           url     (when (realized? auth-url) @auth-url)]
       (cond
         url
         {:host     host
          :status   :auth-required
          :auth-url url
          :message  (str "Tailscale SSH auth required: " url)}

         (not finished?)
         {:host    host
          :status  :unreachable
          :message (str "SSH timed out after " (max 1 (quot timeout-ms 1000)) "s")}

         (#{0 1} (.exitValue jp))
         (let [data (try (json/read-str out-str :key-fn keyword)
                         (catch Exception e {::invalid (ex-message e)}))]
           (cond
             (:host data)
             {:host host :status :ok :result data}

             (:error data)
             {:host host :status :error :message (str (get-in data [:error :message]))}

             :else
             {:host    host
              :status  :error
              :message (if (and (::invalid data) (str/blank? err-str))
                         (str "invalid JSON from remote host: " (::invalid data))
                         (str/trim err-str))}))

         (= 255 (.exitValue jp))
         {:host    host
          :status  :unreachable
          :message (let [msg (str/trim err-str)]
                     (if (str/blank? msg) "SSH connection failed" msg))}

         :else
         {:host    host
          :status  :error
          :message (let [msg (str/trim (if (str/blank? err-str) out-str err-str))]
                     (if (str/blank? msg) (str "remote exited with status " (.exitValue jp)) msg))})))))
(ns harness-plugins-sync.packs
  "Fetches Git plugin packs into immutable snapshots and promotes active links.

  Each pack lives under `<state-dir>/packs/<name>/`:
  - `repo.git/` bare Git repository
  - `revs/<sha>/` immutable unpacked archive of each revision
  - `staged` symlink updated by [[pull-pack!]]
  - `active` symlink updated atomically by [[promote-pack!]]"
  (:require
   [babashka.fs :as fs]
   [babashka.process :as proc]
   [clojure.string :as str])
  (:import
   java.nio.channels.FileChannel
   [java.nio.file Files LinkOption Path StandardCopyOption StandardOpenOption]
   java.security.MessageDigest))

(def ^:private ignored-digest-dirs
  #{".git" ".scratch-org" "node_modules" ".worktrees" ".direnv"})

(defn pack-dir
  "Returns the root state directory for `pack-name` under `state-dir`."
  [state-dir pack-name]
  (str (fs/path state-dir "packs" pack-name)))

(defn active-path
  "Returns the `active` symlink path for `pack-name`."
  [state-dir pack-name]
  (str (fs/path (pack-dir state-dir pack-name) "active")))

(defn staged-path
  "Returns the `staged` symlink path for `pack-name`."
  [state-dir pack-name]
  (str (fs/path (pack-dir state-dir pack-name) "staged")))

(defn with-pack-lock
  "Runs `f` while holding an advisory file lock on `pack-name`."
  [state-dir pack-name f]
  (let [dir       (pack-dir state-dir pack-name)
        _         (fs/create-dirs dir)
        lock-path (fs/path dir ".lock")]
    (with-open [ch (FileChannel/open lock-path
                                     (into-array StandardOpenOption
                                                 [StandardOpenOption/CREATE
                                                  StandardOpenOption/WRITE]))
                _lock (.lock ch)]
      (f))))

(defn atomic-symlink!
  "Atomically points symlink `link-path` at `target-str`."
  [link-path target-str]
  (let [parent (fs/parent link-path)
        _      (fs/create-dirs parent)
        tmp    (fs/path parent (str "." (fs/file-name link-path) ".tmp."
                                    (System/nanoTime)))]
    (try
      (Files/createSymbolicLink tmp (fs/path target-str)
                                (make-array java.nio.file.attribute.FileAttribute 0))
      (Files/move tmp (fs/path link-path)
                  (into-array StandardCopyOption
                              [StandardCopyOption/ATOMIC_MOVE
                               StandardCopyOption/REPLACE_EXISTING]))
      (catch Exception e
        (fs/delete-if-exists tmp)
        (throw e)))))

(defn read-symlink-target
  "Returns the raw symlink target string of `p`, or nil when `p` is not a symlink."
  [p]
  (let [path (fs/path p)]
    (when (Files/isSymbolicLink path)
      (str (Files/readSymbolicLink path)))))

(defn- rev-from-target [target]
  (when (and target (str/starts-with? target "revs/"))
    (subs target (count "revs/"))))

(defn- resolve-link-dir [link-path]
  (when-let [target (read-symlink-target link-path)]
    (let [tpath (fs/path target)]
      (str (fs/normalize (if (.isAbsolute tpath)
                           tpath
                           (fs/path (fs/parent link-path) tpath)))))))

(defn- run-cmd! [args opts]
  (let [res (proc/sh args (merge {:out :string :err :string :continue true} opts))]
    (when-not (zero? (:exit res))
      (throw (ex-info (str "command failed: " (str/join " " args)
                           (when-not (str/blank? (:err res))
                             (str ": " (str/trim (:err res)))))
                      {:code    :pack/git-failed
                       :details {:cmd args :exit (:exit res) :stderr (str/trim (:err res))}})))
    res))

(defn- prune-revs! [revs-dir keep-set retain-revs]
  (when (fs/exists? revs-dir)
    (let [now-ms (System/currentTimeMillis)
          entries (fs/list-dir revs-dir)]
      (doseq [e entries
              :let [nm (str (fs/file-name e))]
              :when (str/starts-with? nm ".tmp-")]
        (let [age-ms (- now-ms (.toMillis (fs/last-modified-time e)))]
          (when (> age-ms (* 60 60 1000))
            (fs/delete-tree e))))
      (let [old-revs (->> entries
                          (remove #(let [nm (str (fs/file-name %))]
                                     (or (str/starts-with? nm ".tmp-")
                                         (contains? keep-set nm))))
                          (sort-by #(.toMillis (fs/last-modified-time %)) >))]
        (doseq [e (drop retain-revs old-revs)]
          (fs/delete-tree e))))))

(defn pull-pack!
  "Fetches `pack-name` (`{:url :branch}`) into `state-dir`, unpacks `revs/<sha>`,
  and updates the `staged` symlink without modifying `active`.

  Options:
  | key           | description |
  |---------------|-------------|
  | `:retain-revs`| Number of old revisions to keep (default `2`) |
  | `:dry-run`    | When true, inspects without mutating disk |"
  [state-dir pack-name {:keys [url branch] :or {branch "main"}} {:keys [retain-revs dry-run] :or {retain-revs 2}}]
  (if dry-run
    {:pack    pack-name
     :url     url
     :branch  branch
     :status  :dry-run
     :staged  (rev-from-target (read-symlink-target (staged-path state-dir pack-name)))
     :active  (rev-from-target (read-symlink-target (active-path state-dir pack-name)))}
    (with-pack-lock state-dir pack-name
      (fn []
        (let [root     (pack-dir state-dir pack-name)
              repo-dir (str (fs/path root "repo.git"))
              revs-dir (str (fs/path root "revs"))
              prev-rev (rev-from-target (read-symlink-target (staged-path state-dir pack-name)))
              act-rev  (rev-from-target (read-symlink-target (active-path state-dir pack-name)))]
          (fs/create-dirs revs-dir)
          (when-not (fs/exists? repo-dir)
            (run-cmd! ["git" "init" "--quiet" "--bare" repo-dir] {}))
          (run-cmd! ["git" "-C" repo-dir "fetch" "--quiet" "--prune"
                     url (str "+refs/heads/" branch ":refs/heads/" branch)]
                    {})
          (let [rev     (str/trim (:out (run-cmd! ["git" "-C" repo-dir "rev-parse" (str "refs/heads/" branch)] {})))
                rev-dir (str (fs/path revs-dir rev))]
            (when-not (fs/exists? rev-dir)
              (let [tmp (str (fs/create-temp-dir {:dir revs-dir :prefix ".tmp-"}))]
                (try
                  (let [git-p (proc/process ["git" "-C" repo-dir "archive" rev] {:err :string})
                        tar-p (proc/process ["tar" "-x" "-C" tmp] {:in (:out git-p) :err :string})
                        tar-r @tar-p
                        git-r @git-p]
                    (when-not (and (zero? (:exit git-r)) (zero? (:exit tar-r)))
                      (throw (ex-info (str "failed to unpack " pack-name "@" rev)
                                      {:code    :pack/git-failed
                                       :details {:pack pack-name :rev rev
                                                 :git-err (:err git-r) :tar-err (:err tar-r)}}))))
                  (Files/move (fs/path tmp) (fs/path rev-dir)
                              (into-array StandardCopyOption [StandardCopyOption/ATOMIC_MOVE]))
                  (catch Exception e
                    (fs/delete-tree tmp)
                    (throw e)))))
            (when (not= prev-rev rev)
              (atomic-symlink! (staged-path state-dir pack-name) (str "revs/" rev)))
            (prune-revs! revs-dir (set (remove nil? [rev act-rev])) retain-revs)
            {:pack         pack-name
             :url          url
             :branch       branch
             :rev          rev
             :previous-rev prev-rev
             :changed?     (not= prev-rev rev)
             :status       (if (= prev-rev rev) :unchanged :fetched)}))))))

(defn content-digest
  "Computes a deterministic SHA-256 digest of files under `root-dir`, ignoring
  VCS and build directories."
  [root-dir]
  (let [root   (fs/path root-dir)
        digest (MessageDigest/getInstance "SHA-256")
        files  (atom [])]
    (letfn [(walk-dir [^Path dir]
              (doseq [entry (sort-by #(str (fs/file-name %)) (fs/list-dir dir))
                      :let [nm (str (fs/file-name entry))]]
                (cond
                  (Files/isSymbolicLink entry)
                  (swap! files conj [:link (str (.relativize root entry))
                                     (str (Files/readSymbolicLink entry))])

                  (Files/isDirectory entry (into-array LinkOption [LinkOption/NOFOLLOW_LINKS]))
                  (when-not (contains? ignored-digest-dirs nm)
                    (walk-dir entry))

                  (Files/isRegularFile entry (into-array LinkOption [LinkOption/NOFOLLOW_LINKS]))
                  (swap! files conj [:file (str (.relativize root entry)) entry]))))]
      (when (fs/exists? root)
        (walk-dir root))
      (doseq [[kind rel target] @files]
        (.update digest (.getBytes (str (name kind) "\0" rel "\0") "UTF-8"))
        (if (= :link kind)
          (.update digest (.getBytes (str target "\0") "UTF-8"))
          (let [bs (Files/readAllBytes ^Path target)]
            (.update digest bs)
            (.update digest (byte-array [0])))))
      (apply str (map #(format "%02x" (bit-and % 0xff)) (.digest digest))))))

(defn promote-pack!
  "Promotes `pack-name`'s `active` symlink to `local-path` (when provided) or
  its `staged` snapshot, and keeps an existing `active` symlink when neither is
  set. `check`, when given, receives the candidate directory and throws to
  reject it: a rejected candidate leaves `active` alone and the result carries
  `:error`, or, with no `active` to keep, throws `:pack/rejected`. Choosing,
  checking, and switching hold the pack lock, so a concurrent pull cannot swap
  the candidate between check and switch.

  Returns a map describing the active pack target, source (`:git` or `:local`),
  revision or digest, the previous active revision, and whether `active` changed."
  [state-dir pack-name {:keys [local-path dry-run check]}]
  (when (and local-path (not (fs/directory? local-path)))
    (throw (ex-info (str "local pack directory does not exist: " local-path)
                    {:code :pack/not-found :details {:pack pack-name :path local-path}})))
  (let [act-link (active-path state-dir pack-name)
        stg-link (staged-path state-dir pack-name)
        promote
        (fn []
          (let [prev-target  (read-symlink-target act-link)
                local-abs    (when local-path (str (fs/absolutize (fs/normalize local-path))))
                [target dir] (cond
                               local-abs                    [local-abs local-abs]
                               (read-symlink-target stg-link) [(read-symlink-target stg-link)
                                                               (resolve-link-dir stg-link)])
                error        (when (and target check)
                               (try
                                 (check dir)
                                 nil
                                 (catch Exception e
                                   (or (ex-message e) (str e)))))
                [target dir] (if (and target (not error))
                               [target dir]
                               [prev-target (when prev-target (resolve-link-dir act-link))])
                changed?     (and (some? target) (not= prev-target target))
                rev          (rev-from-target target)]
            (cond
              (nil? target)
              (if error
                (throw (ex-info error {:code :pack/rejected :details {:pack pack-name}}))
                (throw (ex-info (str "pack '" pack-name "' has no fetched snapshot; run 'harness-plugins-sync sync' or 'pull' first")
                                {:code :pack/not-fetched :details {:pack pack-name}})))

              :else
              (do
                (when (and changed? (not dry-run))
                  (atomic-symlink! act-link target))
                (cond-> {:pack         pack-name
                         :source       (if rev :git :local)
                         :path         dir
                         :active       act-link
                         :rev          rev
                         :digest       (or rev (content-digest dir))
                         :previous-rev (rev-from-target prev-target)
                         :changed?     changed?
                         :status       (cond dry-run :dry-run changed? :promoted :else :unchanged)}
                  error (assoc :error error))))))]
    (if dry-run
      (promote)
      (with-pack-lock state-dir pack-name promote))))

(defn pack-status
  "Inspects `pack-name` under `state-dir` without making changes."
  [state-dir pack-name {:keys [url branch] :or {branch "main"}}]
  (let [act-link   (active-path state-dir pack-name)
        stg-link   (staged-path state-dir pack-name)
        act-target (read-symlink-target act-link)
        stg-target (read-symlink-target stg-link)
        act-rev    (rev-from-target act-target)
        stg-rev    (rev-from-target stg-target)
        act-dir    (resolve-link-dir act-link)
        source     (cond
                     (nil? act-target) :missing
                     act-rev           :git
                     :else             :local)]
    {:pack            pack-name
     :url             url
     :branch          branch
     :source          source
     :active-path     act-link
     :resolved-path   act-dir
     :active-rev      act-rev
     :staged-rev      stg-rev
     :pending-promote (boolean (and stg-target (not= act-target stg-target)))}))
