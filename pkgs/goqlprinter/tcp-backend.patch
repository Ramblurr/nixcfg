@@ -0,0 +1,73 @@
+package brotherql
+
+import (
+	"fmt"
+	"net"
+	"time"
+)
+
+const tcpIOTimeout = 3 * time.Second
+
+// TCPProvider connects to one configured raw TCP printer.
+type TCPProvider struct {
+	address string
+	model   string
+}
+
+func NewTCPProvider(address, model string) *TCPProvider {
+	return &TCPProvider{address: address, model: model}
+}
+
+func (p *TCPProvider) FindPrinters() ([]PrinterInfo, error) {
+	if _, err := GetModel(p.model); err != nil {
+		return nil, err
+	}
+	return []PrinterInfo{{
+		Name:    p.model,
+		Model:   p.model,
+		URI:     "tcp://" + p.address,
+		Backend: "tcp",
+	}}, nil
+}
+
+func (p *TCPProvider) Connect(printer PrinterInfo) (Backend, error) {
+	if printer.URI != "tcp://"+p.address {
+		return nil, fmt.Errorf("TCP printer %q is not configured", printer.URI)
+	}
+	conn, err := net.DialTimeout("tcp", p.address, tcpIOTimeout)
+	if err != nil {
+		return nil, err
+	}
+	return &tcpBackend{Conn: conn, readTimeout: tcpIOTimeout}, nil
+}
+
+func (p *TCPProvider) SupportsStatus() bool { return false }
+
+type tcpBackend struct {
+	net.Conn
+	readTimeout     time.Duration
+	readDeadlineSet bool
+}
+
+func (b *tcpBackend) SetReadTimeout(timeout time.Duration) {
+	b.readTimeout = timeout
+	b.readDeadlineSet = false
+}
+
+func (b *tcpBackend) Read(data []byte) (int, error) {
+	if !b.readDeadlineSet {
+		if err := b.SetReadDeadline(time.Now().Add(b.readTimeout)); err != nil {
+			return 0, err
+		}
+		b.readDeadlineSet = true
+	}
+	return b.Conn.Read(data)
+}
+
+func (b *tcpBackend) Write(data []byte) (int, error) {
+	b.readDeadlineSet = false
+	if err := b.SetWriteDeadline(time.Now().Add(tcpIOTimeout)); err != nil {
+		return 0, err
+	}
+	return b.Conn.Write(data)
+}
diff --git a/brotherql/tcp_backend_test.go b/brotherql/tcp_backend_test.go
new file mode 100644
index 0000000..f0a7888
--- /dev/null
+++ b/brotherql/tcp_backend_test.go
@@ -0,0 +1,51 @@
+package brotherql
+
+import (
+	"io"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestTCPProviderSendsOnlyToConfiguredPrinter(t *testing.T) {
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	if err := listener.(*net.TCPListener).SetDeadline(time.Now().Add(3 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+
+	provider := NewTCPProvider(listener.Addr().String(), "QL-810W")
+	printers, err := provider.FindPrinters()
+	if err != nil || len(printers) != 1 || printers[0].Model != "QL-810W" {
+		t.Fatalf("FindPrinters = %v, %v", printers, err)
+	}
+	if conn, err := provider.Connect(PrinterInfo{URI: "tcp://127.0.0.1:1"}); err == nil {
+		conn.Close()
+		t.Fatal("Connect accepted an unconfigured endpoint")
+	}
+
+	backend, err := provider.Connect(printers[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer backend.Close()
+	if _, err := backend.Write([]byte("raster job")); err != nil {
+		t.Fatal(err)
+	}
+
+	server, err := listener.Accept()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer server.Close()
+	if err := server.SetReadDeadline(time.Now().Add(3 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	got := make([]byte, len("raster job"))
+	if _, err := io.ReadFull(server, got); err != nil || string(got) != "raster job" {
+		t.Fatalf("received %q, %v", got, err)
+	}
+}
