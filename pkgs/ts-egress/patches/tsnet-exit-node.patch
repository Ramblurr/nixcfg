+// isForwarderSYN reports whether pb is a segment the TCP forwarder takes: a
+// SYN without ACK.
+func isForwarderSYN(pb *stack.PacketBuffer) bool {
+	h := header.TCP(pb.TransportHeader().Slice())
+	if len(h) < header.TCPMinimumSize {
+		return false
+	}
+	f := h.Flags()
+	return f.Contains(header.TCPFlagSyn) && !f.Contains(header.TCPFlagAck)
+}
